APP_NAME=Interview Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true
API_PREFIX=/api
LOG_LEVEL=INFO

LANGGRAPH_SQLITE_PATH=data/langgraph.sqlite3
INTERVIEWS_FILE_PATH=data/interviews.md
LOCAL_STATE_PATH=data/runtime.json
RESUME_STORAGE_PATH=data/resumes

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_MODEL_NAME=interview-assistant
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_ROUNDS=4

# Langfuse 可观测性；默认关闭且只上传脱敏摘要。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false

NETEASE_IMAP_HOST=imap.163.com
NETEASE_IMAP_PORT=993
NETEASE_EMAIL=
NETEASE_EMAIL_AUTH_CODE=
BOSS_PROFILE_PATH=data/boss-profile
BOSS_BROWSER_CHANNEL=chrome
JOBS_MAX_CANDIDATES=10
JOBS_PAGES_PER_QUERY=2
JOBS_MAX_SEARCH_PAGES=6
JOBS_PAGE_TIMEOUT_SECONDS=15
JOBS_DOM_STABLE_SECONDS=0.5
JOBS_REQUEST_INTERVAL_SECONDS=3
MOCK_INTERVIEW_MAX_QUESTIONS=8
