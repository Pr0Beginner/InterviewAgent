APP_NAME=Interview Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true
API_PREFIX=/api
LOG_LEVEL=INFO

MYSQL_URL=mysql+pymysql://interview:interview@127.0.0.1:3306/interview_assistant?charset=utf8mb4
MYSQL_ECHO=false
LANGGRAPH_SQLITE_PATH=data/langgraph.sqlite3

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_MODEL_NAME=interview-assistant
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_ROUNDS=4
NETEASE_IMAP_HOST=imap.163.com
NETEASE_IMAP_PORT=993
NETEASE_EMAIL=
NETEASE_EMAIL_AUTH_CODE=
FEISHU_InterviewDate_TOKEN=
FEISHU_Progress_TOKEN=
FEISHU_InterviewQuestion_TOKEN=
FEISHU_CLI_PATH=lark-cli
FEISHU_NODE_PATH=node
FEISHU_CLI_PROFILE=
BOSS_PROFILE_PATH=data/boss-profile
BOSS_BROWSER_CHANNEL=msedge
JOBS_MAX_CANDIDATES=10
MOCK_INTERVIEW_MAX_QUESTIONS=8
