APP_NAME=Interview Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true
API_PREFIX=/api
LOG_LEVEL=INFO

LANGGRAPH_SQLITE_PATH=data/langgraph.sqlite3
INTERVIEWS_FILE_PATH=data/interviews.md
LOCAL_STATE_PATH=data/runtime.json

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_MODEL_NAME=interview-assistant
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_ROUNDS=4
NETEASE_IMAP_HOST=imap.163.com
NETEASE_IMAP_PORT=993
NETEASE_EMAIL=
NETEASE_EMAIL_AUTH_CODE=
BOSS_PROFILE_PATH=data/boss-profile
BOSS_BROWSER_CHANNEL=msedge
JOBS_MAX_CANDIDATES=10
MOCK_INTERVIEW_MAX_QUESTIONS=8
